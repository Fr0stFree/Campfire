[1.022, "o", "\u001b[34m==>\u001b[0m \u001b[1mAuto-updating Homebrew...\u001b[0m\r\n"]
[0.000, "o", "Adjust how often this is run with `$HOMEBREW_AUTO_UPDATE_SECS` or disable with\r\n`$HOMEBREW_NO_AUTO_UPDATE=1`. Hide these hints with `$HOMEBREW_NO_ENV_HINTS=1` (see `man brew`)."]
[0.000, "o", "\r\n"]
[6.539, "o", "\u001b[34m==>\u001b[0m \u001b[1mAuto-updated Homebrew!\u001b[0m\r\n"]
[0.001, "o", "Updated 3 taps (hashicorp/tap, homebrew/core and homebrew/cask).\r\n"]
[0.000, "o", "\u001b[34m==>\u001b[0m \u001b[1mNew Formulae\u001b[0m\r\n"]
[0.000, "o", "all-smi: GPU monitoring tool for NVIDIA/Jetson/Apple Silicon/Tenstorrent\r\n"]
[0.000, "o", "apkid: Android application identifier for compilers, packers, and obfuscators\r\n"]
[0.000, "o", "arcane-cli: Command-line client for the Arcane Docker management platform\r\ndeja: Predictive ghost-text autosuggestions for zsh\r\n"]
[0.000, "o", "hidapitester: Command-line tool to exercise USB HID devices via HIDAPI\r\n"]
[0.000, "o", "kubectl-radar: Missing open-source Kubernetes UI with a built-in MCP server for AI agents\r\nmariadb@12.3: Drop-in replacement for MySQL\r\n"]
[0.000, "o", "modflow6: USGS modular hydrologic model\r\nopenshell: Safe, private runtime for autonomous AI agents\r\n"]
[0.000, "o", "pg_activity: Top-like interactive monitoring tool for PostgreSQL server activity\r\nplink1: Whole-genome association analysis toolset\r\n"]
[0.000, "o", "pypy3.12: Implementation of Python 3 in Python\r\nsdrmm: Modular, client-server software-defined radio\r\n"]
[0.000, "o", "sofka: Kubernetes TUI, reimagined in Rust\r\nsomalier: Relatedness, QC and ancestry checks from BAM/CRAM/VCF\r\ntcltls: OpenSSL extension to Tcl\r\ntfswitch: Command-line tool to switch between Terraform versions"]
[0.000, "o", "\r\n"]
[0.000, "o", "vortix: Terminal UI for WireGuard and OpenVPN with live telemetry and leak guarding\r\nwavemon: Ncurses-based monitoring application for wireless network devices on Linux"]
[0.000, "o", "\r\n"]
[0.000, "o", "zig@0.16: Programming language designed for robustness, optimality, and clarity\r\n"]
[0.001, "o", "\u001b[34m==>\u001b[0m \u001b[1mNew Casks\u001b[0m\r\n"]
[0.000, "o", "activitywatch@experimental: Time tracker\r\n"]
[0.000, "o", "amp-app: Coding agent and development environment\r\nargo-books: Accounting software for small businesses\r\nbuholaunchpad: Launchpad alternative\r\n"]
[0.000, "o", "cuadriver: Background desktop automation driver for AI agents\r\ndeepseek-harness: Plugin-based AI agent desktop application\r\n"]
[0.000, "o", "font-aptos\r\n"]
[0.000, "o", "font-pennstander\r\n"]
[0.000, "o", "font-xmind\r\n"]
[0.000, "o", "hagimimonitordirect: Menu bar monitor for system performance and hardware\r\n"]
[0.000, "o", "ideashell: AI partner for notes, voice, and to-dos\r\nideashell-cn: AI partner for notes, voice, and to-dos (China edition)\r\n"]
[0.000, "o", "jpki: Digital signature and authentication client for the My Number Card (JPKI)\r\nlocal-studio: Local workstation for running and managing language models"]
[0.000, "o", "\r\n"]
[0.000, "o", "manus-cue: Personal AI agents with their own identities\r\nmarkpad: Markdown viewer and editor\r\nmdhero: Markdown viewer and editor\r\n"]
[0.000, "o", "mindroom: Self-hostable AI stack for multi-user, multi-agent workflows on Matrix\r\nnapari: Multi-dimensional image viewer for Python\r\n"]
[0.000, "o", "plane: Project management tool for tasks, sprints and docs\r\nrobbietilton-compositor: Photoshop alternative\r\n"]
[0.000, "o", "ruffle: Flash Player emulator\r\n"]
[0.000, "o", "sandisk: Managing SanDisk external drives\r\n"]
[0.000, "o", "sdrmm-app: Modular, client-server software-defined radio\r\nssl-download-manager: Software manager for SSL plug-ins\r\nvolumehud: Bring back the pre-Tahoe volume and brightness HUDs"]
[0.000, "o", "\r\n"]
[0.000, "o", "wheelwizard: Mod manager for Mario Kart Wii and Retro Rewind\r\n"]
[0.212, "o", "\r\nYou have \u001b[1m71\u001b[0m outdated formulae installed.\r\n"]
[0.049, "o", "\r\n"]
[1.881, "o", "\u001b[33mWarning:\u001b[0m The following taps are not trusted:\r\n  hashicorp/tap\r\n  kaspersky/monorepo\r\n  powershell/tap\r\n\r\nHomebrew is currently ignoring formulae, casks and commands"]
[0.000, "o", "\r\nfrom these taps because tap trust is required.\r\nPrefer trusting only the specific formulae, casks or commands you need.\r\nTrust installed formulae from these taps with:"]
[0.000, "o", "\r\n  brew trust --formula kaspersky/monorepo/ast\r\n  brew trust --formula powershell/tap/powershell\r\nTrust other specific casks and commands with:\r\n"]
[0.000, "o", "  brew trust --cask <user>/<tap>/<cask>\r\n  brew trust --command <user>/<tap>/<command>\r\nWhole-tap trust is broader and includes all current and future formulae,"]
[0.000, "o", "\r\ncasks and commands from the listed taps. Trust whole taps with:\r\n  brew trust hashicorp/tap kaspersky/monorepo powershell/tap\r\nUntap them with:"]
[0.000, "o", "\r\n  brew untap hashicorp/tap kaspersky/monorepo powershell/tap\r\nFor more information, see:\r\n  \u001b[4mhttps://docs.brew.sh/Tap-Trust\u001b[24m\r\n"]
